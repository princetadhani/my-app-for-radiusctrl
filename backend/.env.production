# ========================================
# FreeRADIUS Control Backend - Production Configuration (Docker)
# ========================================
# This file contains production defaults for Docker deployment
# These values are baked into the Docker image
# DO NOT modify unless you're rebuilding the image
# ========================================

# ----------------------------------------
# Server Configuration
# ----------------------------------------
PORT=3001
NODE_ENV=production

# ----------------------------------------
# FreeRADIUS Paths
# ----------------------------------------
# These paths are INSIDE the container, mapped to host paths via Docker volumes
FREERADIUS_BASE_DIR=/etc/freeradius/3.0
FREERADIUS_LOG_FILE=/var/log/freeradius/radius.log
FREERADIUS_COA_DIR=/etc/freeradius/3.0/coa
FREERADIUS_SERVICE_NAME=freeradius

# ----------------------------------------
# WebSocket Configuration
# ----------------------------------------
# Allow connections from any origin (nginx handles actual access control)
WEBSOCKET_CORS_ORIGIN=*
